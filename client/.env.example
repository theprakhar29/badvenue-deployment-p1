# Only needed when the frontend and backend are deployed separately (e.g.
# Vercel frontend + Render backend). In local dev, leave this UNSET —
# requests go to a relative "/api" path, which Vite's dev server proxy
# (vite.config.js) forwards to your local backend automatically.
#
# In production, Vite bakes this value into the build at BUILD TIME (not
# read at runtime), so it must be set in your hosting platform's build
# environment variables (e.g. Vercel project settings), not just a .env
# file that only exists locally.
#
# Must point at your deployed backend's /api path, e.g.:
VITE_API_URL="https://your-backend.onrender.com/api"
