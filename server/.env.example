# MongoDB connection string.
# Local:   mongodb://localhost:27017/ticket_platform
# Atlas:   mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/ticket_platform
MONGODB_URI="mongodb://localhost:27017/ticket_platform"

# Random secret used to sign organizer JWTs.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET="replace-with-a-long-random-string"

# Port the Express server listens on
PORT=4000

# The React client's origin, for CORS. Accepts a comma-separated list —
# useful for Vercel, where your production URL and preview-deployment URLs
# are different: "https://your-app.vercel.app,https://your-app-git-dev.vercel.app"
# Each entry must be an exact origin (scheme + host), no trailing slash.
CLIENT_ORIGIN="http://localhost:5173"

# ============================================================================
# RAZORPAY — currently placeholder values, safe to run locally but payments
# will fail against Razorpay's real API until you swap these for real keys.
#
# To go live:
#   1. Sign up / log in at https://dashboard.razorpay.com
#   2. Settings -> API Keys -> generate a Key ID + Key Secret (Test mode is
#      fine for staging; switch to Live mode keys when you're ready for real
#      money). Paste them in below.
#   3. Settings -> Webhooks -> Add New Webhook, pointing at:
#        https://<your-deployed-server>/api/public/payments/webhook
#      Set a secret when creating it, and paste that same secret below.
#
# Nothing else needs to change — server/src/utils/payment.js is the only
# file that reads these.
# ============================================================================
RAZORPAY_KEY_ID="asdfghjkl"
RAZORPAY_KEY_SECRET="asdfghjkl"
RAZORPAY_WEBHOOK_SECRET="asdfghjkl"

# ============================================================================
# EMAIL — provider switch. Set EMAIL_PROVIDER to "smtp" (default) or
# "resend", then fill in that provider's variables below.
#
# EMAIL_PROVIDER=smtp (default, works locally / on hosts that allow SMTP):
#   Any SMTP provider works (Gmail SMTP, SendGrid, AWS SES, Mailgun...).
#   IMPORTANT: Render's free tier (since Sept 2025) and some other hosts
#   block outbound SMTP ports 25/465/587 entirely — SMTP will time out
#   there regardless of how correct your credentials are. If you hit
#   "Connection timeout" in production but it worked locally, this is
#   almost certainly why. Switch to EMAIL_PROVIDER=resend instead.
#
# EMAIL_PROVIDER=resend (works on hosts that block SMTP, e.g. Render free):
#   Sends over HTTPS, not SMTP ports, so host-level SMTP blocking doesn't
#   affect it. Get a key at resend.com/api-keys — free tier is 3,000
#   emails/month (100/day). For quick testing with zero setup, leave
#   MAIL_FROM_EMAIL unset and it sends from Resend's shared
#   "onboarding@resend.dev" address; for your own domain, verify it in the
#   Resend dashboard first and set MAIL_FROM_EMAIL to an address on it.
#   NOTE: this integration hasn't been tested against a live Resend account
#   from this environment (network-restricted sandbox) — the request/error
#   handling is verified robust, but the exact API response shape isn't
#   confirmed. Verify your first real send.
#
# Nothing else needs to change — server/src/utils/notifications.js is the
# only file that reads these.
# ============================================================================
EMAIL_PROVIDER="smtp"

SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="asdfghjkl"
SMTP_PASSWORD="asdfghjkl"
MAIL_FROM_EMAIL="tickets@example.com"
MAIL_FROM_NAME="Marquee"

RESEND_API_KEY="asdfghjkl"

# ============================================================================
# SMS — provider switch. Set SMS_PROVIDER to "msg91" (recommended for Indian
# numbers) or "twilio", then fill in that provider's three variables below.
# Only the selected provider's variables are used.
#
# MSG91 (console.msg91.com):
#   - AUTH_KEY: API -> Auth Key on the dashboard
#   - SENDER_ID: a 6-character alphanumeric ID (e.g. "MRQUEE"); needs DLT
#     registration for production sends — MSG91's dashboard guides you
#     through this. Their free trial credits work for initial testing
#     without full DLT setup.
#   - This integration is built against MSG91's documented API but hasn't
#     been tested against a live account from here — verify your first real
#     send carefully.
#
# Twilio (console.twilio.com): Account SID + Auth Token on the dashboard
#   homepage; FROM_NUMBER from Phone Numbers -> Manage -> Active Numbers.
#   Note: getting a Twilio number with Indian (+91) sending capability
#   requires business verification — a regulatory (TRAI/DLT) restriction,
#   not a Twilio-specific one. MSG91 is the more common choice for Indian
#   SMS specifically because of this.
# ============================================================================
SMS_PROVIDER="msg91"

MSG91_AUTH_KEY="asdfghjkl"
MSG91_SENDER_ID="asdfghjkl"
MSG91_ROUTE="4"

TWILIO_ACCOUNT_SID="asdfghjkl"
TWILIO_AUTH_TOKEN="asdfghjkl"
TWILIO_FROM_NUMBER="+10000000000"

NODE_ENV=development
